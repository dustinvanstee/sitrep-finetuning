# NVIDIA API Configuration (hosted service)
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
NIM_LOCAL_BASE_URL=http://localhost:8000/v1

# Hugging Face (for model downloads)
# Get your token from: https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_YOUR_TOKEN_HERE

# Training Configuration (A100 80GB optimized)
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Project Paths
PROJECT_ROOT=/Users/slopp/logistics-sitrep-finetuning
DATA_DIR=${PROJECT_ROOT}/data
OUTPUT_DIR=${PROJECT_ROOT}/outputs
CONFIG_DIR=${PROJECT_ROOT}/config

# Logging
LOG_LEVEL=INFO
WANDB_API_KEY=  # Optional: for Weights & Biases logging
WANDB_PROJECT=logistics-sitrep-finetuning

# Data Generation Settings
NUM_SCENARIOS=3
SAMPLES_PER_SCENARIO=30

# Training Settings
MAX_EPOCHS=3
BATCH_SIZE=2
LEARNING_RATE=1e-4

# GPU Memory Settings
CUDA_LAUNCH_BLOCKING=0  # Set to 1 for debugging
PYTORCH_NO_CUDA_MEMORY_CACHING=0
